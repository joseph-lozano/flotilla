#!/bin/bash
# The pull request checks, run here instead of on GitHub: the checks the CI workflows run on
# main, each signed off on its own with `gh signoff <check>`
# (https://github.com/basecamp/gh-signoff), as the commit status signoff/<check>. The signoff
# ruleset requires them for a pull request to merge:
#
#   gh signoff install rustfmt clippy clippy-snapshot tests docs
#
# A check that passes is marked green, one that fails red, saying so. A check for paths the
# branch doesn't change is marked green without running, as CI's path filters would skip it.
# Every check runs, even after one fails, and the script fails if any did.
#
# Run it after every push to a pull request's branch. It checks the commit that's pushed, so the
# tree must be clean and HEAD pushed.
#
#   script/signoff              # the checks for what the branch changes since main, then sign off
#   script/signoff --all        # every check, whatever changed
#   script/signoff --no-signoff # the checks alone: nothing is posted, nothing need be pushed
#
# The checks, by the paths the branch changes (the same paths as the workflows'):
#   rustfmt, clippy, clippy-snapshot, tests (ci.yml): cargo fmt --check, clippy without and
#                             with the snapshot feature, cargo test
#   docs (docs.yml):          script/docs-md --check
#   swift (flotillakit.yml):  swift test, on a Mac only. It isn't required: off a Mac it's
#                             skipped with a warning and nothing is posted, and flotillakit.yml
#                             runs it on main after the merge.
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
cd "$root"

usage() {
  echo "usage: script/signoff [--all] [--no-signoff]" >&2
  exit 2
}
all=0 post=1
while (( $# )); do
  case $1 in
    --all) all=1 ;;
    --no-signoff) post=0 ;;
    *) usage ;;
  esac
  shift
done
fail() { echo "script/signoff: $*" >&2; exit 1; }

if (( post )); then
  [[ -z $(git status --porcelain) ]] || fail "the tree has changes: commit and push them first"
  if ! gh signoff --help > /dev/null 2>&1; then
    echo "==> Installing gh-signoff"
    gh extension install basecamp/gh-signoff
  fi
fi

# What the branch changes since it left main. Before the checks, so a commit that isn't pushed
# stops here rather than after them.
git fetch -q origin main
if (( post )); then
  branch=$(git symbolic-ref --short -q HEAD) || fail "not on a branch"
  git fetch -q origin "+refs/heads/$branch:refs/remotes/origin/$branch" 2> /dev/null ||
    fail "$branch isn't on origin: push it first"
  git merge-base --is-ancestor HEAD "origin/$branch" || fail "HEAD isn't pushed: push it first"
fi
base=$(git merge-base origin/main HEAD)
# The work tree too, and new files, for --no-signoff; signing off needs them committed.
changed=$(git diff --name-only "$base"; git ls-files --others --exclude-standard)
touches() {
  (( all )) && return 0
  local pattern
  for pattern in "$@"; do
    grep -Eq "$pattern" <<< "$changed" && return 0
  done
  return 1
}

steps=() unaffected=() skipped=()
# Keep these in step with the paths in .github/workflows.
if touches '^crates/' '^mobile/fixtures/' '^relay/test/vectors\.json$' '^m0-samples/' \
  '^Cargo\.(toml|lock)$' '^rustfmt\.toml$' '^\.github/workflows/ci\.yml$' '^script/signoff$'; then
  steps+=(rustfmt clippy clippy-snapshot tests)
else
  unaffected+=(rustfmt clippy clippy-snapshot tests)
fi
if touches '^www/' '^script/docs-md$' '^\.github/workflows/docs\.yml$' '^script/signoff$'; then
  steps+=(docs)
else
  unaffected+=(docs)
fi
if touches '^ios/FlotillaKit/' '^mobile/fixtures/' '^relay/test/vectors\.json$' \
  '^\.github/workflows/flotillakit\.yml$'; then
  if [[ $(uname -s) == Darwin ]] && command -v swift > /dev/null; then
    steps+=(swift)
  else
    skipped+=("swift test (FlotillaKit): needs a Mac; flotillakit.yml runs it on main after the merge")
  fi
fi

run() {
  case $1 in
    rustfmt) cargo fmt --all --check ;;
    clippy) cargo clippy --workspace --all-targets --locked -- -D warnings ;;
    clippy-snapshot) cargo clippy --workspace --all-targets --locked --features flotilla-app/snapshot -- -D warnings ;;
    tests) cargo test --workspace --locked --no-fail-fast ;;
    docs) script/docs-md --check ;;
    swift) (cd ios/FlotillaKit && swift test) ;;
  esac
}

# ${a[@]+"${a[@]}"}: an empty array is an error under set -u in the Mac's bash 3.2.
if (( ${#unaffected[@]} )); then
  echo "==> Nothing to check for ${unaffected[*]}: the branch doesn't change their paths"
  if (( post )); then gh signoff ${unaffected[@]+"${unaffected[@]}"}; fi
fi

failed=()
for step in ${steps[@]+"${steps[@]}"}; do
  echo "==> $step"
  if run "$step"; then
    if (( post )); then gh signoff "$step"; fi
  else
    echo "script/signoff: $step failed" >&2
    failed+=("$step")
    if (( post )); then gh signoff fail "$step" --description "$step failed" || true; fi
  fi
done

for note in ${skipped[@]+"${skipped[@]}"}; do
  echo "script/signoff: skipped $note" >&2
done
if (( ${#failed[@]} )); then
  fail "failed: ${failed[*]}"
fi
if (( post )); then
  signed=(${unaffected[@]+"${unaffected[@]}"} ${steps[@]+"${steps[@]}"})
  echo "==> Signed off: ${signed[*]}"
else
  echo "==> Passed (not signed off: --no-signoff)"
fi
