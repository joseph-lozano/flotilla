#!/bin/bash
# Build a .deb of the Linux desktop app: target/release/flotilla_<version>_<arch>.deb. It
# installs the release binary as /usr/bin/flotilla-app, a .desktop file named by the app's id
# (com.useflotilla.flotilla) that registers the flotilla:// scheme (pairing links), and the
# icon in the hicolor sizes, cut from a full-bleed 1024×1024 PNG (default
# design/icons/AppIcon.png) into a rounded square, its pixels kept crisp.
#
# --dev builds target/debug/flotilla-dev_<version>_<arch>.deb from a debug build instead, to
# install beside the release one: Flotilla Dev, /usr/bin/flotilla-dev-app, its own icon
# (design/icons/AppIcon-dev.png) and flotilla-dev:// links.
#
# --appimage also builds target/release/Flotilla-<x86_64|aarch64>.AppImage from the same files,
# for other distributions (see the AppImage part below).
#
# Needs dpkg-dev (dpkg-shlibdeps), ImageMagick, and GPUI's build packages (docs/server.md); for
# --appimage, patchelf and squashfs-tools too.
#
#   script/bundle-linux [--dev | --appimage] [artwork.png]
#   sudo apt install ./target/release/flotilla_0.1.0_amd64.deb
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
appimage=0
if [[ ${1:-} == --appimage ]]; then
  shift
  appimage=1
  for tool in patchelf mksquashfs; do
    command -v $tool >/dev/null || { echo "$tool is missing: sudo apt install patchelf squashfs-tools" >&2; exit 1; }
  done
fi
if [[ ${1:-} == --dev ]]; then
  (( !appimage )) || { echo "an AppImage is of the release app only" >&2; exit 1; }
  shift
  pkg=flotilla-dev name="Flotilla Dev" id=com.useflotilla.flotilla.dev profile=debug scheme=flotilla-dev bin=flotilla-dev-app
  art=${1:-$root/design/icons/AppIcon-dev.png}
  build=(cargo build -p flotilla-app --manifest-path "$root/Cargo.toml")
else
  pkg=flotilla name=Flotilla id=com.useflotilla.flotilla profile=release scheme=flotilla bin=flotilla-app
  art=${1:-$root/design/icons/AppIcon.png}
  build=(cargo build --release -p flotilla-app --manifest-path "$root/Cargo.toml")
fi
version=$(sed -n 's/^version = "\(.*\)"/\1/p' "$root/Cargo.toml" | head -1)
arch=$(dpkg --print-architecture)
deb="$root/target/$profile/${pkg}_${version}_${arch}.deb"

[[ -f $art ]] || { echo "no artwork at $art" >&2; exit 1; }
command -v dpkg-shlibdeps >/dev/null || { echo "dpkg-shlibdeps is missing: sudo apt install dpkg-dev" >&2; exit 1; }
if command -v magick >/dev/null; then im=magick; elif command -v convert >/dev/null; then im=convert; else
  echo "ImageMagick is missing: sudo apt install imagemagick" >&2; exit 1
fi
"${build[@]}"

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
stage=$tmp/root
mkdir -p "$stage/DEBIAN" "$stage/usr/bin" "$stage/usr/share/applications" "$stage/usr/share/doc/$pkg"
install -m 0755 "$root/target/$profile/flotilla-app" "$stage/usr/bin/$bin"
strip --strip-unneeded "$stage/usr/bin/$bin"

# The icon: the artwork on the same grid as the Mac's (an 824/1024 body, corners 185.4/1024),
# without its shadow. Nearest-neighbour inside, so the pixel art stays crisp.
for size in 16 24 32 48 64 128 256 512; do
  dir=$stage/usr/share/icons/hicolor/${size}x${size}/apps
  mkdir -p "$dir"
  body=$(( (size * 824 + 512) / 1024 ))
  radius=$(awk "BEGIN { printf \"%.2f\", $body * 185.4 / 824 }")
  "$im" "$art" -filter point -resize "${body}x${body}!" \
    \( -size "${body}x${body}" xc:black -fill white -draw "roundrectangle 0,0,$((body - 1)),$((body - 1)),$radius,$radius" \) \
    -alpha off -compose CopyOpacity -composite \
    -compose over -background none -gravity center -extent "${size}x${size}" "PNG32:$dir/$id.png"
done

# Exec takes the link as its argument (%u): a second start hands it to the running app.
cat > "$stage/usr/share/applications/$id.desktop" <<DESKTOP
[Desktop Entry]
Type=Application
Name=$name
Comment=Coding agents, each in its own VM
Exec=$bin %u
Icon=$id
Terminal=false
Categories=Development;
Keywords=agents;Claude;Codex;boat;VM;
MimeType=x-scheme-handler/$scheme;
StartupWMClass=$id
StartupNotify=false
DESKTOP
if command -v desktop-file-validate >/dev/null; then desktop-file-validate "$stage/usr/share/applications/$id.desktop"; fi

{
  echo "Format: https://www.debian.org/doc/packaging-manuals/copyright-format/1.0/"
  echo "Upstream-Name: Flotilla"
  echo "Source: https://useflotilla.com"
  echo
  echo "Files: *"
  echo "License: MIT"
  sed 's/^$/./; s/^/ /' "$root/LICENSE"
} > "$stage/usr/share/doc/$pkg/copyright"
commit=$(git -C "$root" rev-parse --short HEAD 2>/dev/null || echo unknown)
printf '%s (%s) unstable; urgency=medium\n\n  * Built from %s by script/bundle-linux.\n\n -- Flotilla <you@example.com>  %s\n' \
  "$pkg" "$version" "$commit" "$(date -R)" | gzip -9n > "$stage/usr/share/doc/$pkg/changelog.gz"

# The libraries the binary links, as package names. GPUI also loads Vulkan or EGL, and
# Wayland's client library, when it runs; xdg-open opens links; desktop-file-utils indexes the
# .desktop file, so xdg-open finds the flotilla:// handler.
mkdir -p "$tmp/shlibs/debian"
printf 'Source: %s\n\nPackage: %s\nArchitecture: any\n' "$pkg" "$pkg" > "$tmp/shlibs/debian/control"
shlibs=$(cd "$tmp/shlibs" && dpkg-shlibdeps -O "$stage/usr/bin/$bin" 2>/dev/null | sed -n 's/^shlibs:Depends=//p')
[[ -n $shlibs ]] || { echo "dpkg-shlibdeps found no libraries for $bin" >&2; exit 1; }

cat > "$stage/DEBIAN/control" <<CONTROL
Package: $pkg
Version: $version
Architecture: $arch
Maintainer: Flotilla <you@example.com>
Installed-Size: $(du -sk "$stage/usr" | cut -f1)
Depends: $shlibs, libegl1 | libvulkan1, libwayland-client0, xdg-utils, desktop-file-utils
Recommends: xdg-desktop-portal, libegl-mesa0 | mesa-vulkan-drivers
Section: devel
Priority: optional
Homepage: https://useflotilla.com
Description: Coding agents, each in its own VM
 Flotilla runs coding-agent threads (Claude Code, Codex and others), each in
 its own boat.dev VM, and keeps them in order.
CONTROL

dpkg-deb --build --root-owner-group "$stage" "$deb" >/dev/null
echo "built $deb"
(( appimage )) || exit 0

# The AppImage: the same files, run by AppImage's static runtime, which mounts them with FUSE
# and needs no libfuse2 (Ubuntu 22.04 and later don't have it). Pinned, and checked.
machine=$(uname -m)
case $machine in
  x86_64) runtime_sha=2fca8b443c92510f1483a883f60061ad09b46b978b2631c807cd873a47ec260d ;;
  aarch64) runtime_sha=00cbdfcf917cc6c0ff6d3347d59e0ca1f7f45a6df1a428a0d6d8a78664d87444 ;;
  *) echo "no AppImage runtime for $machine" >&2; exit 1 ;;
esac
curl -fsSL -o "$tmp/runtime" "https://github.com/AppImage/type2-runtime/releases/download/20251108/runtime-$machine"
echo "$runtime_sha  $tmp/runtime" | sha256sum -c --quiet

app=$tmp/AppDir
mkdir -p "$app/usr/lib"
cp -a "$stage/usr/bin" "$stage/usr/share" "$app/usr/"
cp "$stage/usr/share/applications/$id.desktop" "$app/"
ln -s "usr/share/icons/hicolor/256x256/apps/$id.png" "$app/$id.png"
ln -s "$id.png" "$app/.DirIcon"
ln -s "usr/bin/$bin" "$app/AppRun"
# Every desktop has glibc, libxcb, a GPU driver and the Vulkan loader, so those stay out. Not
# every one has libxkbcommon-x11 (sway, i3 or Xfce may not), which the binary needs to start; it
# only works with the libxkbcommon it was built with, so both go in, with its libxcb-xkb (a
# package of its own on Debian and Ubuntu). The binary finds them by its RPATH: unlike
# LD_LIBRARY_PATH, that doesn't reach the programs it starts, like a browser.
for lib in libxkbcommon.so.0 libxkbcommon-x11.so.0 libxcb-xkb.so.1; do
  path=$(ldd "$app/usr/bin/$bin" | awk -v lib="$lib" '$1 == lib { print $3 }')
  [[ -f $path ]] || { echo "$bin doesn't link $lib" >&2; exit 1; }
  install -m 0644 "$path" "$app/usr/lib/$lib"
  package=$(dpkg -S "$(readlink -f "$path")" | cut -d: -f1)
  install -D -m 0644 "/usr/share/doc/$package/copyright" "$app/usr/share/doc/$package/copyright"
done
patchelf --force-rpath --set-rpath '$ORIGIN/../lib' "$app/usr/bin/$bin"

image="$root/target/$profile/$name-$machine.AppImage"
mksquashfs "$app" "$tmp/payload" -root-owned -noappend -comp zstd -quiet
cat "$tmp/runtime" "$tmp/payload" > "$image"
chmod 0755 "$image"
echo "built $image"
